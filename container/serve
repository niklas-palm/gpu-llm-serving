#!/usr/bin/env bash
# Entrypoint: start vLLM's OpenAI-compatible server with the configured flags.
#
# Runs the engine's own server directly with no wrapper. A shim in front would add a hop to every
# request and another component to keep compatible with the engine's API surface.
set -euo pipefail

PORT="${PORT:-8080}"

# /opt/model is a HOST directory shared by every task on this instance (see the task definition), so
# one copy of the weights is reused across restarts and across replicas. That is what stops a
# crash-looping task filling the disk with a fresh copy per attempt.
SHARED_CACHE="${SHARED_CACHE:-/opt/model}"
mkdir -p "${SHARED_CACHE}"

# Point the Hugging Face cache at the shared volume before anything can download. Without these, the
# hub cache defaults to ~/.cache/huggingface INSIDE the container: every task start writes its own
# multi-tens-of-GiB copy into the container's writable layer, a stopped container keeps that layer, and
# a crash-looping task fills the root volume.
export HF_HOME="${SHARED_CACHE}/hf"
export HUGGINGFACE_HUB_CACHE="${HF_HOME}/hub"
mkdir -p "${HUGGINGFACE_HUB_CACHE}"

ARGS=(
  # Also the served model name: /v1/models reports it and gateways route by it.
  --model "${MODEL_ID:?MODEL_ID is required}"
  --host 0.0.0.0
  --port "${PORT}"
  --tensor-parallel-size "${TENSOR_PARALLEL:-1}"
  --max-num-seqs "${MAX_NUM_SEQS:-256}"
  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION:-0.95}"
  --kv-cache-dtype "${KV_CACHE_DTYPE:-fp8}"
)

# Both of these measured no effect across every value worth testing, so 0 means "do not pass the
# flag" and the engine picks. Passing a guessed value can only make things worse.
[[ "${MAX_MODEL_LEN:-0}" != "0" ]] && ARGS+=(--max-model-len "${MAX_MODEL_LEN}")
[[ "${MAX_NUM_BATCHED_TOKENS:-0}" != "0" ]] && ARGS+=(--max-num-batched-tokens "${MAX_NUM_BATCHED_TOKENS}")

# vLLM enables prefix caching by default, so only an explicit opt-out needs a flag. Note that turning
# it off roughly halves the concurrency this instance can serve within a latency budget.
if [[ "${ENABLE_PREFIX_CACHING:-true}" == "false" ]]; then
  ARGS+=(--no-enable-prefix-caching)
fi

# Measured -13% decode in FP8 and +15% in bf16, so there is no right default - off unless asked.
if [[ "${ENABLE_EXPERT_PARALLEL:-false}" == "true" ]]; then
  ARGS+=(--enable-expert-parallel)
fi

[[ -n "${QUANTIZATION:-}" ]] && ARGS+=(--quantization "${QUANTIZATION}")

# Escape hatch for any flag this script does not model. Keeps the container useful without a rebuild
# every time you want to try something.
if [[ -n "${EXTRA_ARGS// /}" ]]; then
  # shlex, not shell word-splitting: quoted arguments with spaces survive, and a * is not a glob.
  # NUL-separated so a newline inside a quoted value stays inside it; a value shlex cannot parse
  # stops the start, because silently starting without the flags is how a fix appears not to work.
  # Through a file, not a variable: bash variables cannot hold NUL.
  EXTRA_FILE=$(mktemp)
  if ! python3 -c 'import shlex, sys; sys.stdout.write("\0".join(shlex.split(sys.argv[1])))' "${EXTRA_ARGS}" > "${EXTRA_FILE}"; then
    echo "[serve] extraArgs is not shell-parseable: ${EXTRA_ARGS}" >&2
    exit 1
  fi
  mapfile -d '' -t EXTRA < "${EXTRA_FILE}"
  rm -f "${EXTRA_FILE}"
  ARGS+=("${EXTRA[@]}")
fi

echo "[serve] vllm serve ${ARGS[*]}"
exec vllm serve "${ARGS[@]}"
