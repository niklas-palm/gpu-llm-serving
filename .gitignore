__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# CDK build output. Anywhere - the directory follows wherever you invoke the CLI from.
cdk.out*/

# CDK caches resolved account-specific values here (availability zones, AMI ids). It is a local
# cache, not configuration, and committing it would leak the account id it was synthesised against.
# Matched at any depth for the same reason as cdk.out.
cdk.context.json

# Local, uncommitted config overrides, deep-merged over config.yaml. The API key, the image URI
# and anything account-specific live here, so the tracked config stays generic.
config.local.yaml
